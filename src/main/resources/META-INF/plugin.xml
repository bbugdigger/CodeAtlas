<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.bugdigger.CodeAtlas</id>
    <name>CodeAtlas</name>
    <vendor email="dognus818@gmail.com" url="https://github.com/bbugdigger/CodeAtlas">bugdigger</vendor>

    <description><![CDATA[
        <h3>Natural-language code navigation for IntelliJ IDEA.</h3>
        <p>
          Press <em>Shift-Shift</em>, switch to the <em>Code Atlas</em> tab, and ask
          questions like <em>"where is authentication implemented?"</em> or
          <em>"how does the payment flow work?"</em> — jump straight to the matching
          class, method, or top-level function.
        </p>
        <h4>How it works</h4>
        <ul>
          <li><b>Search runs fully offline.</b> A small embedding model
              (BGE-small INT8, ~33 MB) is bundled with the plugin and runs in the
              IDE process. No API key or network connection is required.</li>
          <li><b>Search Everywhere integration.</b> CodeAtlas appears as its own
              tab in IntelliJ's Search Everywhere popup. A status-bar widget shows
              index progress and offers one-click access to the search.</li>
          <li><b>Right-click integration.</b> Select code in the editor, then
              <em>Search with CodeAtlas</em> to query for the selection or the
              symbol at the caret without leaving the file.</li>
          <li><b>MCP server.</b> Optional: expose the CodeAtlas index over the
              Model Context Protocol so external clients (Claude Desktop, etc.)
              can perform semantic search against your project.</li>
        </ul>
        <h4>Supported languages</h4>
        <p>Kotlin and Java in this release. The
           <code>LanguageAdapter</code> layer is designed to accept more
           languages in future versions.</p>
    ]]></description>

    <!-- Phase 1 supports Kotlin + Java. The LanguageAdapter layer is designed to accept more
         languages later without changes to the core. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <resource-bundle>messages.CodeAtlasBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Project-level CodeAtlasIndexService is a light service (@Service annotation). -->
        <searchEverywhereContributor
            implementation="com.bugdigger.codeatlas.searcheverywhere.CodeAtlasSearchContributorFactory"/>
        <statusBarWidgetFactory
            id="CodeAtlasStatusBarWidget"
            implementation="com.bugdigger.codeatlas.statusbar.CodeAtlasStatusBarWidgetFactory"/>
        <postStartupActivity
            implementation="com.bugdigger.codeatlas.startup.CodeAtlasStartupActivity"/>
        <postStartupActivity
            implementation="com.bugdigger.codeatlas.mcp.McpServerLifecycle"/>
        <projectConfigurable
            id="com.bugdigger.codeatlas.settings"
            displayName="CodeAtlas"
            instance="com.bugdigger.codeatlas.settings.CodeAtlasSettingsConfigurable"/>

        <!-- Application-scoped services for the embedded MCP server (one server per IDE instance). -->
        <applicationService
            serviceImplementation="com.bugdigger.codeatlas.mcp.McpServerSettings"/>
        <applicationService
            serviceImplementation="com.bugdigger.codeatlas.mcp.ActiveProjectTracker"/>
        <applicationService
            serviceImplementation="com.bugdigger.codeatlas.mcp.McpServerService"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <actions>
        <action
            id="CodeAtlas.AskAction"
            class="com.bugdigger.codeatlas.actions.AskCodeAtlasAction"
            text="Search with CodeAtlas"
            description="Open Search Everywhere on the CodeAtlas tab, pre-filled with the selection or symbol at the caret.">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <group
            id="CodeAtlas.ToolsGroup"
            text="CodeAtlas"
            description="CodeAtlas index management actions"
            popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action
                id="CodeAtlas.FocusSearchAction"
                class="com.bugdigger.codeatlas.actions.FocusCodeAtlasSearchAction"
                text="Focus Search"
                description="Open Search Everywhere on the CodeAtlas tab."/>
            <action
                id="CodeAtlas.RebuildIndexAction"
                class="com.bugdigger.codeatlas.actions.RebuildIndexAction"
                text="Rebuild Index"
                description="Force a fresh full reindex of the open project."/>
            <action
                id="CodeAtlas.ClearCacheAction"
                class="com.bugdigger.codeatlas.actions.ClearCacheAction"
                text="Clear Cache and Rebuild"
                description="Delete the persisted index cache and rebuild from scratch."/>
        </group>
    </actions>
</idea-plugin>
